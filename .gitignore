# ============================================================
# 构建产物
# ============================================================
build/
build-*/
cmake-build-*/
out/

# CMake 生成的中间文件（只会在 in-source 构建时出现）
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
CMakeUserPresets.json
install_manifest.txt

# 编译产物（静态库/对象/依赖文件）
*.o
*.obj
*.a
*.so
*.dylib
*.dSYM/
*.d

# ============================================================
# 运行时产物（--dump-yuv / --dump-pcm / --snapshot 的输出）
# ============================================================
*.yuv
*.pcm
*.bmp

# ============================================================
# 第三方源码
# ============================================================
# 两个 tarball（ffmpeg.tar.gz、SDL3-3.4.20.tar.gz）是构建输入，必须入库。
# 只忽略 CMake/ExternalProject 解压出来的目录，避免把解压产物重复提交。
3rdparty/ffmpeg/
3rdparty/SDL3-*/

# ============================================================
# 系统 / 编辑器 / 本地环境
# ============================================================
.DS_Store
._*
.Spotlight-V100
.Trashes
.idea/
.vscode/
*.swp
*.xcodeproj/
*.xcworkspace/
.workbuddy/
*.log

# ============================================================
# 注意：upstream/ 是 git submodule，**不要**加进这里
# ------------------------------------------------------------
# - 它由 .gitmodules + 父仓库里的 gitlink（mode 160000）管理，
#   内容不在本仓库里，git 也不会跟踪它内部的文件；
# - .gitignore 只对「未跟踪」的路径生效，写了不会改变 submodule 的行为，
#   反而容易让人误以为这个目录可以随便删；
# - 正确做法是 clone 后执行：
#       git submodule update --init --recursive
#   本仓库不再对 upstream 打补丁；若 `git status` 显示 upstream 前有小写 m，
#   说明子模块工作区被改脏了，需要排查（正常状态应是干净的）。
# ============================================================
